  "multi_turn_cases": [
    {
      "name": "retain character and time while replacing story with chill",
      "history": ["I have an hour and want story on my Titan."],
      "current": "Actually something chill.",
      "expected_preferences": {"character": "Titan", "time_minutes": 60, "primary_goal": "casual_chill", "intensity": "chill"},
      "forbidden_behaviors": ["discard Titan", "discard the time window", "retain story as the primary goal"]
    },
    {
      "name": "override character and retain chill",
      "history": ["Give me something chill on my Titan."],
      "current": "Hunter instead.",
      "expected_preferences": {"character": "Hunter", "primary_goal": "casual_chill", "intensity": "chill"},
      "forbidden_behaviors": ["recommend Titan", "discard the chill constraint"]
    },
    {
      "name": "replace stale time",
      "history": ["I have 30 minutes."],
      "current": "I have another hour now.",
      "expected_preferences": {"time_minutes": 60},
      "forbidden_behaviors": ["retain the stale 30-minute limit", "add the two time windows"]
    },
    {
      "name": "retain exclusion while updating goal",
      "history": ["No PvP."],
      "current": "I want better gear.",
      "expected_preferences": {"primary_goal": "gear_rewards", "exclusions": ["pvp"]},
      "forbidden_behaviors": ["recommend PvP for its loot", "discard the PvP exclusion"]
    },
    {
      "name": "clear only story goal",
      "history": ["I have an hour and want story on my Titan."],
      "current": "Forget the story preference.",
      "expected_preferences": {"character": "Titan", "time_minutes": 60, "primary_goal": "unspecified"},
      "forbidden_behaviors": ["retain story", "clear character or time"]
    },
    {
      "name": "do not reask known constraints",
      "history": ["I have 45 minutes and want story on my Titan."],
      "current": "What should I do?",
      "expected_preferences": {"character": "Titan", "time_minutes": 45, "primary_goal": "story_progression"},
      "forbidden_behaviors": ["ask which character", "ask how much time", "ask story or loot"]
    },
    {
      "name": "current turn overrides every conflict",
      "history": ["I have an hour and want story on my Titan."],
      "current": "Give me a 20-minute gear run on Hunter.",
      "expected_preferences": {"character": "Hunter", "time_minutes": 20, "primary_goal": "gear_rewards"},
      "forbidden_behaviors": ["retain Titan", "retain story", "retain 60 minutes"]
    },
    {
      "name": "do not infer preferences from Guardian history",
      "history": [],
      "current": "What should I do next?",
      "guardian_recent_activity": "Crucible Control",
      "expected_preferences": {"character": "unspecified", "time_minutes": null, "primary_goal": "unspecified", "activity_mode": "unspecified", "exclusions": []},
      "forbidden_behaviors": ["infer a PvP preference from recent Crucible activity"]
    }
